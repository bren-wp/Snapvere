{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-privileged",
  "description": "Only Settings can manage autostart, open user-selected paths/URLs and choose a capture folder.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "autostart:default",
    "opener:default",
    "dialog:allow-open",
    "store:allow-load",
    "store:allow-get-store",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save"
  ]
}
