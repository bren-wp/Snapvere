# Snapvere security and cache headers applied by static hosting.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'none'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self' 'sha256-uajlxsPQ4Jo6W4fgW5sv+cwmjnHVwP64qHKITPLq/eU=' 'sha256-Vk4233Z0N+ELdeJN4GntaNsyZp9y2LREQRuaQx0J7W4=' 'sha256-ZnYJX5ypMaaAhxxWhSEjbMkhO2A9yPmbzEQH3LFaITA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.svg
  Cache-Control: public, max-age=0, must-revalidate

/files/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
