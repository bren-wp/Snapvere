{
  "manifest_version": 3,
  "name": "SNAPVERE — Vivaldi",
  "version": "0.2.1",
  "description": "Capture visible tabs, crop regions and scroll webpages; annotate PNG privately.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Capture tab with SNAPVERE",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-visible-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "Save a screenshot of the visible tab"
    }
  }
}
